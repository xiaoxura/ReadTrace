[Unit]
Description=ReadPilot - self-hosted WeRead reading dashboard
After=network.target

[Service]
Type=simple
User=readpilot
Group=readpilot
WorkingDirectory=/opt/readpilot
ExecStart=/opt/readpilot/wxread-panel -addr 127.0.0.1:8720 -data /opt/readpilot/data -no-open
Restart=always
RestartSec=3

# Hardening (optional, adjust to your paths)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/readpilot/data
ProtectHome=true

[Install]
WantedBy=multi-user.target
